{
  "name": "@verelo/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "corepack pnpm build && node scripts/launch-electron.mjs",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --project tsconfig.build.json && node scripts/copy-renderer.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "electron": "44.5.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@recallai/desktop-sdk": "2.0.36"
  }
}
