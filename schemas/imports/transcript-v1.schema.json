{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "GENERATED by scripts/generate-contracts.py; edit contracts/models.py or contracts/http.py.",
  "$defs": {
    "TranscriptSegment": {
      "additionalProperties": false,
      "anyOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "start_ms"
                ]
              },
              {
                "required": [
                  "end_ms"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "start_ms": {
              "type": "null"
            },
            "end_ms": {
              "type": "null"
            }
          },
          "required": [
            "start_ms",
            "end_ms"
          ]
        },
        {
          "properties": {
            "start_ms": {
              "type": "integer"
            },
            "end_ms": {
              "type": "integer"
            }
          },
          "required": [
            "start_ms",
            "end_ms"
          ]
        }
      ],
      "description": "Times are paired; semantic validation also requires end_ms >= start_ms. Preserve text verbatim.",
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "speaker_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker Label"
        },
        "start_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ms"
        },
        "end_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ms"
        }
      },
      "required": [
        "text"
      ],
      "title": "TranscriptSegment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "language": {
      "maxLength": 35,
      "minLength": 2,
      "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$",
      "title": "Language",
      "type": "string"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/TranscriptSegment"
      },
      "minItems": 1,
      "title": "Segments",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "language",
    "segments"
  ],
  "title": "TranscriptImport",
  "type": "object"
}
