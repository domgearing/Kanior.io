# Isolated staging example. Do not source this file without replacing every placeholder.
# Inject secrets from a managed secret store; never commit populated values.
VERELO_ENVIRONMENT=staging
VERELO_INTEGRATIONS_MODE=live
VERELO_IDENTITY_PROVIDER=entra
VERELO_PUBLIC_ORIGIN=https://staging.verelo.io
VERELO_API_PUBLIC_ORIGIN=https://staging-api.verelo.io
VERELO_ENTRA_REDIRECT_URI=https://staging-api.verelo.io/api/v1/auth/entra/callback
VERELO_SESSION_COOKIE_SECURE=true
VITE_API_BASE_URL=https://staging-api.verelo.io
VERELO_DESKTOP_API_BASE_URL=https://staging-api.verelo.io
VERELO_RECALL_WEBHOOK_URL=https://staging-api.verelo.io/api/v1/webhooks/recall

# Register a single-tenant confidential web app in Entra. Require enterprise-app
# user assignment, and add the optional ID-token acct and groups claims.
# VERELO_ENTRA_TENANT_ID=<tenant UUID>
# VERELO_ENTRA_CLIENT_ID=<app client UUID>
# VERELO_ENTRA_EMPLOYEE_GROUP_ID=<assigned employee group UUID>
# VERELO_ENTRA_CLIENT_SECRET=<inject at runtime only>

# Use distinct database identities, managed private storage and provider accounts.
# VERELO_DATABASE_URL=<API runtime role URL>
# VERELO_WORKER_DATABASE_URL=<worker runtime role URL>
# VERELO_MIGRATOR_DATABASE_URL=<migration role URL; migration process only>
# VERELO_RECALL_API_BASE_URL=<approved regional Recall endpoint>
# VERELO_RECALL_API_KEY=<inject at runtime only>
# VERELO_RECALL_WEBHOOK_SECRET=<inject at runtime only>
# VERELO_ASSEMBLYAI_API_KEY=<inject at runtime only>
# VERELO_B2_S3_ENDPOINT=<approved private bucket endpoint>
# VERELO_B2_REGION=<approved region>
# VERELO_B2_BUCKET_NAME=<private source bucket>
# VERELO_B2_APPLICATION_KEY_ID=<inject at runtime only>
# VERELO_B2_APPLICATION_KEY=<inject at runtime only>

# Provision each permitted project with scripts/provision_deployment_worker.py.
# VERELO_WORKER_TENANT_ID=<tenant UUID>
# VERELO_WORKER_WORKSPACE_ID=<workspace UUID>
# VERELO_WORKER_SERVICE_IDENTITY_ID=<provisioned service UUID>
# VERELO_WORKER_PROJECT_IDS=<explicit comma-separated project UUIDs>
