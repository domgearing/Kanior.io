{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "GENERATED by scripts/generate-contracts.py; edit contracts/models.py or contracts/http.py.",
  "$defs": {
    "SelectedSpan": {
      "additionalProperties": false,
      "properties": {
        "passage_id": {
          "format": "uuid",
          "title": "Passage Id",
          "type": "string"
        },
        "start_character": {
          "minimum": 0,
          "title": "Start Character",
          "type": "integer"
        },
        "end_character": {
          "minimum": 1,
          "title": "End Character",
          "type": "integer"
        }
      },
      "required": [
        "passage_id",
        "start_character",
        "end_character"
      ],
      "title": "SelectedSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "selected_spans": {
      "items": {
        "$ref": "#/$defs/SelectedSpan"
      },
      "maxItems": 8,
      "title": "Selected Spans",
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "selected_spans"
  ],
  "title": "EvidenceSpanSelection",
  "type": "object"
}
