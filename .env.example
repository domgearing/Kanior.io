# Copy this file to .env for local development. Values are synthetic and local-only.
# Never put provider keys or production tenant identifiers in this file.

KANIOR_ENVIRONMENT=local
KANIOR_DATABASE_URL=postgresql+psycopg://kanior_api:kanior_api@127.0.0.1:5432/kanior
# Local Compose uses one bootstrap role. Staging and production must inject a
# distinct migrator credential through KANIOR_MIGRATOR_DATABASE_URL.
KANIOR_MIGRATOR_DATABASE_URL=postgresql+psycopg://kanior_migrator:kanior_migrator@127.0.0.1:5432/kanior
KANIOR_INTEGRATIONS_MODE=fake
KANIOR_API_HOST=127.0.0.1
KANIOR_API_PORT=8000
KANIOR_LOG_LEVEL=INFO

# Local PostgreSQL container settings
KANIOR_POSTGRES_PORT=5432
KANIOR_POSTGRES_USER=kanior_admin
KANIOR_POSTGRES_PASSWORD=kanior_admin
KANIOR_POSTGRES_DB=kanior
KANIOR_MIGRATOR_DB_PASSWORD=kanior_migrator
KANIOR_API_DB_PASSWORD=kanior_api
KANIOR_WORKER_DB_PASSWORD=kanior_worker

# Provider-neutral HTTP defaults
KANIOR_INTEGRATION_CONNECT_TIMEOUT_SECONDS=5
KANIOR_INTEGRATION_REQUEST_TIMEOUT_SECONDS=30
KANIOR_INTEGRATION_TRANSFER_IDLE_TIMEOUT_SECONDS=120
KANIOR_INTEGRATION_TRANSFER_DEADLINE_SECONDS=1800
KANIOR_INTEGRATION_MAX_HTTP_ATTEMPTS=3

# Live provider configuration is intentionally unset. See docs/INTEGRATIONS.md
# and the provider guides before enabling live integrations. Store secret values
# in an approved secret store and inject them at runtime; never commit them here.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_REDIRECT_URI=
# ENTRA_EMPLOYEE_GROUP_ID=
# ENTRA_REQUIRED_EMPLOYEE_ROLE=
# ENTRA_CLIENT_CREDENTIAL_REF=
# SESSION_SECRET_REF=
