# Copy this file to .env for local development. Values are synthetic and local-only.
# Never put provider keys or production tenant identifiers in this file.

VERELO_ENVIRONMENT=local
VERELO_DATABASE_URL=postgresql+psycopg://verelo_api:verelo_api@127.0.0.1:5432/verelo
# Local Compose uses one bootstrap role. Staging and production must inject a
# distinct migrator credential through VERELO_MIGRATOR_DATABASE_URL.
VERELO_MIGRATOR_DATABASE_URL=postgresql+psycopg://verelo_migrator:verelo_migrator@127.0.0.1:5432/verelo
VERELO_WORKER_DATABASE_URL=postgresql+psycopg://verelo_worker:verelo_worker@127.0.0.1:5432/verelo
# Used only by local provisioning commands; never inject this into deployed API/worker processes.
VERELO_LOCAL_ADMIN_DATABASE_URL=postgresql+psycopg://verelo_admin:verelo_admin@127.0.0.1:5432/verelo
VERELO_OBJECT_STORAGE_ROOT=.artifacts/objects
VERELO_INTEGRATIONS_MODE=fake
VERELO_API_HOST=127.0.0.1
VERELO_API_PORT=8000
VERELO_LOG_LEVEL=INFO
VERELO_IDENTITY_PROVIDER=magic_link
VERELO_MAGIC_LINK_DELIVERY=local
VERELO_MAGIC_LINK_BASE_URL=http://127.0.0.1:5173/auth/verify
VERELO_DEVELOPMENT_MAILBOX_ROOT=.artifacts/dev-mailbox
VERELO_SESSION_COOKIE_SECURE=false
VERELO_PUBLIC_ORIGIN=http://127.0.0.1:5173
# VERELO_API_PUBLIC_ORIGIN=https://dev-api.verelo.io
# VITE_API_BASE_URL=https://dev-api.verelo.io

# Electron signs in interactively and selects a meeting at runtime.
# VERELO_DESKTOP_API_BASE_URL=http://127.0.0.1:8000
# For an attended live Recall test:
# VERELO_DESKTOP_CAPTURE_PROVIDER=recall_desktop

# Durable worker scope. Provision a service identity plus outbox.dispatch and
# jobs.execute grants for every listed project before starting `python -m workers`.
# VERELO_WORKER_TENANT_ID=
# VERELO_WORKER_WORKSPACE_ID=
# VERELO_WORKER_SERVICE_IDENTITY_ID=
# VERELO_WORKER_PROJECT_IDS=
# VERELO_WORKER_RUN_ONCE=false

# Local PostgreSQL container settings
VERELO_POSTGRES_PORT=5432
VERELO_POSTGRES_USER=verelo_admin
VERELO_POSTGRES_PASSWORD=verelo_admin
VERELO_POSTGRES_DB=verelo
VERELO_MIGRATOR_DB_PASSWORD=verelo_migrator
VERELO_API_DB_PASSWORD=verelo_api
VERELO_WORKER_DB_PASSWORD=verelo_worker

# Provider-neutral HTTP defaults
VERELO_INTEGRATION_CONNECT_TIMEOUT_SECONDS=5
VERELO_INTEGRATION_REQUEST_TIMEOUT_SECONDS=30
VERELO_INTEGRATION_TRANSFER_IDLE_TIMEOUT_SECONDS=120
VERELO_INTEGRATION_TRANSFER_DEADLINE_SECONDS=1800
VERELO_INTEGRATION_MAX_HTTP_ATTEMPTS=3

# Live provider configuration is intentionally unset. See docs/INTEGRATIONS.md
# and the provider guides before enabling live integrations. Store secret values
# in an approved secret store and inject them at runtime; never commit them here.
# ENTRA_TENANT_ID=
